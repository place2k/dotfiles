kcopy() {
  klip() { qdbus org.kde.klipper /klipper org.kde.klipper.klipper.setClipboardContents "$data" }
  if [[ $# -eq 0 ]]; then
    data="$(cat)"
    klip
  else
    for data; do
      [[ -f $data ]] && data="$(cat $data)"
      klip
    done
  fi
}

mcd() {
  if [[ $# -eq 0 ]]; then
    return 1
  elif [[ $# -eq 1 ]]; then
    md $1 && cd $_
  else
    md $@ && pud $@
  fi
}

