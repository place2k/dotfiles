tweakperms() {
  if [[ $1 == -h || -z $1 ]]; then
    echo "Usage: $funcstack[1] [FLAGS] [DIRECTORY]"
    echo 'Flags:'
    echo '-h         show this message and exit'
    echo '-r         run find(1) as root'
    echo '-i         make DIRECTORY world-inaccessible (with modes: dirs=700, files=600)'
    echo '-u         respect umask'
    echo '-d MODE    use MODE (octal or symbolic) for directories'
    echo '-f MODE    use MODE (octal or symbolic) for files'
    return 1
  fi

  local dir dmode=755 fmode=644 dmode_user fmode_user respect_umask=false
  local -a find=(find)

  while [[ $1 == -[a-z] ]]; do
    case $1 in
      -r) find+=(sudo find);;
      -i) dmode=700 fmode=600;;
      -u) respect_umask=true;;
      -d) dmode_user=$2; shift;;
      -f) fmode_user=$2; shift;;
      *) echo "Invalid flag: $1. Run $funcstack[1] -h to see the valid flags." && return 1;;
    esac
    shift
  done

  test -n "$dmode_user" && dmode=$_
  test -n "$fmode_user" && fmode=$_
  dir=$1

  if $respect_umask; then
    umask() { eval mode=\$$1mode; qalc -t -b octal "0o$mode xor (0o$mode & 0o$(builtin umask))" }
    dmode=$(umask d)
    fmode=$(umask f)
  fi

  $find $dir -type d -exec chmod $dmode {} \; -o -type f -exec chmod $fmode {} \;
}

proc_cmd() {
  [[ $# -eq 0 ]] && local args=(self) || local args=($@)
  for pid in $args; do
    [[ -d /proc/$pid ]] && tr '\0' ' ' </proc/$pid/cmdline || printf '%d: no such PID.' $pid >&2
    echo
  done
}

proc_find() {
  local PROCS=($(ps aux))
  local out=$(grep -P $1 <<< $PROCS[*] | grep -v grep)
  if [[ -n $out ]]; then
    echo ${PROCS[1]}
    echo $out
  else
    echo "No process found." >&2
    return 1
  fi
}

view_func() {
#  set -x
  local fname=$1
  local simple_view=false

  [[ $1 == -s || $1 == --simple ]] && simple_view=true && fname=$2
  [[ -z $fname ]] && fname=$funcstack[1] # this function's name

  local origins=$(whence -v $fname)

  [[ $fname != $funcstack[1] ]] && [[ $? -ne 0 || -z $origins || $origins != *is\ a\ shell\ function* ]] && echo "$fname: not a zsh function." >&2 && return 1

  get_function_code() {
    local code="$(sed -n ${fline}p $ffile)"
    local internal_funcs_seen=0
    local fline_end=$fline
#    set -x

    if [[ "$code" =~ "(function )?$fname\s*(\(\s*\))? \{\$" ]]; then
      tail +$((fline+1)) $ffile | \
        while read -r code_line; do
#          set +x
          code_line="$(sed -r 's/(.*})\s?#\s?.*$/\1/' <<< $code_line)"
          printf -v code '%s\n%s' "$code" "$code_line"
          ((++fline_end))
#          set -x

          if [[ "$code_line" =~ '\s*\{\s*$' || "$code_line" =~ '.*(\(\s*\))? \{$' ]]; then
            ((++internal_funcs_seen))
          elif [[ "$code_line" =~ '^\s*\}\s*$' ]]; then
            if ((internal_funcs_seen)); then
              ((--internal_funcs_seen))
            elif [[ ! "$code_line" =~ '^.*\(\) \{' ]]; then
              break
            fi
          fi
        done
    fi

    printf '%d\0%s' $fline_end "$code"
  }

  local ffile="$(sed -E 's/^.* from (.*)$/\1/' <<< $origins)"
  local ffilename=$(sed 's#'$HOME'#~#' <<< "$ffile")
  local fline=$(grep -Ponm1 "^(function )?$fname(\(\))? " "$ffile" | cut -d: -f1)

  get_function_code | IFS=$'\0' read -r fline_end fcode

  (( fline == fline_end )) && local frange=$fline || local frange=$fline–$fline_end

  if $simple_view; then
    bat -pp --line-range $fline:$fline_end --file-name "$ffilename:$frange" $ffile
  else
    bat -l zsh --color=always --line-range $fline:$fline_end --file-name "$ffilename:$frange" $ffile
  fi
}

repch() {
  local c n s
  [[ -z $1 ]] && return
  c="$1" # quotes all around here in case $1 is a space char
  n=${2:-10}
  (( $#c > 1 )) && c="$c[1]"
  while (( n-- > 0 )); do s+="$c"; done
  echo "$s"
}

