# make m3u playlist file in the current directory
makem3u() {
  local fnames=($PWD)
  local start=$PWD

  [[ $# -gt 0 ]] && fnames=$@

  for dir in $fnames; do
    cd $dir
    dir=$(basename $dir)
    /bin/ls -I $dir.m3u -N > $dir.m3u8
  done

  cd $start
}

