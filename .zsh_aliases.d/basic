# ============================ complex aliases and argument-taking aliases, defined as functions ============================

reprios() {
  local pids=($1)
  [[ ! $pids[1] =~ \d+ ]] && pids=($(pgrep $!))
  for pid in $pids; do
    sudo ionice -c1 -n0        -p $pid
    sudo renice --priority -19 -p $pid
    sudo chrt -p 15               $pid
  done
}

reprio() {
  local pids=($1)
  [[ ! $pids[1] =~ \d+ ]] && pids=($(pgrep $!))
  for pid in $pids; do
    ionice -c2 -n0        -p $pid
    renice --priority -10 -p $pid
  done
}


